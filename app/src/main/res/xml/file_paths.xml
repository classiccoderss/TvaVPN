<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately scoped to the cache root only, which is where UpdateChecker
  writes the downloaded update APK and nothing else. No other directory
  (filesDir, external storage, ...) is exposed through this provider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="." />
</paths>
