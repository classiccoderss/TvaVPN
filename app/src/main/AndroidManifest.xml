<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 1.5.0 custom configs: scanning a config QR code. Asked for only when the
         user taps "Scan a QR code"; the camera is optional hardware. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!--
      RE-ADDED on request, for the in-app "Check for updates" page
      (UpdatePage.kt / UpdateChecker.kt). 1.2.2 removed this permission as the
      single most over-privileged thing the app could do; re-adding it was not
      done casually, and the old code-delivery path was not simply restored:

        - the download only ever comes from the project's own GitHub Releases
          API/CDN over HTTPS;
        - the file is verified (package name + signing certificate must match
          the app already installed) BEFORE it is handed to the installer, and
          deleted immediately on any mismatch - see UpdateChecker for the
          exact check;
        - the file lives only in the app's cache dir and is deleted on the
          next process start unconditionally, which covers both failure and
          the success path (an in-place update kills this process);
        - the OS's own "Install app" confirmation is never skipped - nothing
          declaring this permission CAN skip it, by platform design.

      IMPORTANT, read together with SignerIdentity.kt's F-1 note: the
      signature check above does not protect against a release signed with
      the project's OWN key by someone other than the intended maintainer,
      because the signing keystore is committed to the repository
      (.github/ci-keystore.jks.b64) and that finding is still open. An
      automated updater is only as trustworthy as that repository and its
      release pipeline. Rotating the signing key out of the repo closes that
      gap; this permission re-add does not, and was not meant to.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Split tunneling needs to list the device's launchable apps so the user
         can pick which apps to include/exclude from the tunnel. We only query
         launcher-visible apps (not QUERY_ALL_PACKAGES), which keeps Play policy
         happy and avoids the sensitive all-packages permission. -->
    <!--
      ANDROID TV (1.3.1, issue #21).

      A VPN app is exactly what a TV needs and nothing here was stopping it from
      working - it was stopping it from being INSTALLABLE and FINDABLE. Two things
      were missing:

        * A TV has no touchscreen. Android treats android.hardware.touchscreen as
          implicitly REQUIRED, so Google Play and the TV launcher filtered this app
          out of a TV entirely. Declaring it not required is what makes the APK
          eligible at all.
        * A TV launcher only shows activities in the LEANBACK_LAUNCHER category,
          which is added to MainActivity below along with a banner.

      android.software.leanback is declared NOT required on purpose: the same APK
      must keep installing on phones, which do not have it. This is a
      compatibility declaration, not a separate TV build - the Compose UI is
      unchanged and remains touch-shaped. D-pad focus traversal has NOT been
      designed for, and that is the honest limit of what 1.3.1 does here.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AetherApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.AetherMobile"
        tools:replace="android:fullBackupContent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.AetherMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Issue #21: without this category a TV launcher never lists the
                     app, however well it would otherwise run. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.AetherVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Aether censorship-circumvention VPN tunnel while active" />
        </service>

        <!-- Quick Settings tile: one-tap connect/disconnect from the shade. -->
        <service
            android:name=".vpn.AetherTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Home-screen widget (feature merge): one-tap connect /
          disconnect plus live status on the launcher. Not exported; only the
          system AppWidgetService delivers updates to it, and our toggle
          broadcast is sent with an explicit component, so no other app can
          trigger it. updatePeriodMillis=0 — repaints are pushed from the VPN
          service's state-change hook, never on a timer.
        -->
        <receiver
            android:name=".widget.AetherWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aether_widget_info" />
        </receiver>

        <!--
          Crash report screen (feature merge): shows the fatal
          exception saved by AetherApp's crash handler on the previous run.
          Not exported; only MainActivity can open it.
        -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.AetherMobile" />

        <!-- 1.5.0: the custom-config QR scanner, always portrait. -->
        <activity
            android:name=".ui.settings.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!--
          RE-ADDED for UpdateChecker.install(): hands the downloaded, verified
          update APK (app-private cache only, see res/xml/file_paths.xml) to the
          system package installer as a content:// URI. exported="false" and
          grantUriPermissions="true": no other app can query this provider; a
          URI is only ever usable by the one app (the system installer) we
          explicitly grant it to, via FLAG_GRANT_READ_URI_PERMISSION on the
          single install Intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
